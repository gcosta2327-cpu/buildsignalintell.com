# API Configuration
PYTHONUNBUFFERED=1
ENVIRONMENT=production

# Database (update with real values from Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/buildsignalintell

# Security
SECRET_KEY=your-secret-key-here-change-in-railway-dashboard
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=https://buildsignalintell.com,https://www.buildsignalintell.com

# AWS (if using S3)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=your-bucket

# OAuth (if configured)
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
